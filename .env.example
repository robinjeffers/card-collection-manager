# Copy to .env and fill in before running `docker compose up`.

# Secret used by Better Auth to sign sessions. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL the app is reachable at. For local Docker this is
# http://localhost:3000. When sharing via Cloudflare Tunnel, set it to your
# tunnel hostname, e.g. https://cards.example.com — this makes auth cookies
# and trusted origins line up with the domain users actually visit.
BETTER_AUTH_URL=http://localhost:3000

# Postgres credentials for the bundled db service (docker-compose).
POSTGRES_USER=cards
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cards

# If you point the app at an EXTERNAL database instead of the bundled one,
# set DATABASE_URL directly and remove the db service from docker-compose.yml.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Where uploaded card artwork is stored. In docker-compose this is set to
# /data/uploads and backed by the `uploads-data` volume, so you normally do
# not need to change it. Override only for a custom mount path.
# UPLOAD_DIR=/data/uploads
